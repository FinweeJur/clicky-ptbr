# ============================================================
# Clicky for Windows — API Keys (all optional, auto-detected)
# ============================================================
# Copy this file to .env and fill in the keys you have.
# Clicky auto-detects what's available and uses the best one.
# If no keys are set, it falls back to Ollama (free, local).

# ── LLM Providers (priority: Claude > OpenAI > Copilot > Gemini > DeepSeek > Sabia > Ollama) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Botoes simplificados do companheiro Seu Nono ─────────────
# DeepSeek e Sabia (Maritaca). Mesmos nomes de chave usados no portal
# Controle Popular, para reaproveitar a mesma variavel.
AI_API_KEY_DEEPSEEK=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

AI_API_KEY_MARITACA=
MARITACA_BASE_URL=https://chat.maritaca.ai/api
MARITACA_MODEL=sabiazinho-4

# ── Portal Controle Popular (Seu Nono) ───────────────────────
# Quando ligado, o companheiro responde pelo RAG do portal, com fontes —
# a mesma resposta que o site daria. A foto da tela nunca vai ao portal.
CLICKY_PORTAL_ATIVO=0
CLICKY_PORTAL_URL=https://www.controlepopular.com.br
# Só quando o servidor do portal exigir (COMPANHEIRO_TOKEN no Guara).
COMPANHEIRO_TOKEN=

# Any OpenAI-compatible server works via the OpenAI provider — set the base
# URL + a default model, put the provider's key in OPENAI_API_KEY. Examples:
#   DeepSeek:   OPENAI_BASE_URL=https://api.deepseek.com   OPENAI_DEFAULT_MODEL=deepseek-chat
#   DashScope:  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=

# ── Speech-to-Text ───────────────────────────────────────────
# Leave empty to use faster-whisper (free, local, runs on CPU)
DEEPGRAM_API_KEY=
# OPENAI_API_KEY also enables OpenAI Whisper if set above

# ── Text-to-Speech ───────────────────────────────────────────
# Leave empty to use edge-tts (free, no key, Microsoft neural)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Web Search (for grounding LLM with live info) ────────────
# Leave empty to use DuckDuckGo (free, no key)
TAVILY_API_KEY=

# ── Ollama Settings ──────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Legacy single-model knob (used as fallback if the two below are empty)
# llama3.2-vision no longer loads on current Ollama (dropped 'mllama'
# architecture) — it returns HTTP 500 on every screen-aware question.
OLLAMA_MODEL=qwen2.5vl:3b
# Per-task model selection — vision = screen-aware, text = Code Mode / journal Q&A.
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen2.5vl:7b

# ── LM Studio Settings ───────────────────────────────────────
# Alternative to Ollama. Start LM Studio → Developer tab → Start Server,
# load a model, then select "lmstudio" from Tray → Model. No key needed.
LMSTUDIO_HOST=http://localhost:1234/v1
# Leave empty to use whatever model is currently loaded in LM Studio.
LMSTUDIO_MODEL=

# ── App Settings ─────────────────────────────────────────────
# Hotkey to talk to Clicky. Hold it and speak, or tap it once and speak —
# either way Clicky answers when you stop talking.
CLICKY_HOTKEY=ctrl+win

# Microphone mode:
#   hotkey  (default) mic opens only while you're asking something
#   ambient           mic stays open and listens for the "Clicky" wake word
# ambient costs a continuous Whisper pass over everything it hears.
CLICKY_MIC_MODE=hotkey

# How long the hotkey may be held before it counts as hold-to-talk rather
# than a tap. Below this, releasing the key doesn't stop the recording.
CLICKY_TAP_MAX_SECONDS=0.6
# Whisper model size: tiny, base, small, medium (larger = slower but more accurate)
WHISPER_MODEL=base

# Which LLM to use on startup: claude, openai, gemini, ollama, lmstudio,
# deepseek, maritaca, portal
CLICKY_ACTIVE_LLM=lmstudio

# ── Bichinho que segue o cursor ──────────────────────────────
# preguica (padrao, companheiro Seu Nono) ou triangulo (buddy azul original)
CLICKY_BUDDY_THEME=preguica
# Tamanho: 1 = 36 px, 2 = 72 px (padrao), 3 = 108 px
CLICKY_BUDDY_ESCALA=2
